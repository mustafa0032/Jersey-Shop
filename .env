# ── JerseyBase Email Config ───────────────────────────────────────────────────
# Your Gmail address
GMAIL_USER=jerseyphase@gmail.com

# Gmail App Password (NOT your normal Gmail password!)
# How to get it:
#   1. Go to myaccount.google.com
#   2. Security → 2-Step Verification (must be ON)
#   3. Security → App passwords
#   4. Select app: "Mail", device: "Other" → name it "JerseyBase"
#   5. Copy the 16-character password and paste it below (no spaces)
GMAIL_APP_PASSWORD=your_app_password_here

# Server port (leave as 3000)
PORT=3000
